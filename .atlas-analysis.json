  "keyFeatures": [
    "ACID-compliant transactions with full MVCC (Multi-Version Concurrency Control)",
    "Advanced indexing: B-tree, Hash, GiST, GIN, SP-GiST, BRIN, and Bloom indexes",
    "Streaming and logical replication for high availability and read scaling",
    "Extensible type system with user-defined types, operators, and aggregate functions",
    "Rich procedural language support: PL/pgSQL, PL/Python, PL/Perl, PL/Tcl",
    "Full-text search with language-aware stemming, ranking, and highlighting",
    "Native JSON/JSONB support with powerful query operators",
    "Foreign Data Wrappers (FDW) for querying external data sources",
    "Row-level security and fine-grained access control",
    "Partitioned tables and parallel query execution",
    "Point-in-time recovery (PITR) and continuous archiving via WAL",
    "Rich set of built-in contrib extensions (pg_stat_statements, pgcrypto, etc.)"
  ],
  "publicApiSurface": [
    "SELECT / INSERT / UPDATE / DELETE / MERGE SQL statements",
    "CREATE TABLE, ALTER TABLE, DROP TABLE DDL commands",
    "CREATE INDEX (B-tree, GiST, GIN, BRIN, Hash, SP-GiST, Bloom)",
    "CREATE FUNCTION / PROCEDURE with PL/pgSQL, PL/Python, PL/Perl, PL/Tcl",
    "COPY — bulk data import/export",
    "EXPLAIN / ANALYZE — query plan analysis",
    "CREATE PUBLICATION / CREATE SUBSCRIPTION — logical replication",
    "pg_dump / pg_restore — backup and restore utilities",
    "psql — interactive terminal client",
    "initdb / pg_ctl — server initialization and control",
    "pg_basebackup — physical backup streaming",
    "libpq C client library API",
    "ECPG embedded SQL for C programs",
    "SPI (Server Programming Interface) for C extensions",
    "Background Worker API (bgworker)",
    "Logical Decoding API",
    "Foreign Data Wrapper (FDW) API",
    "Table Access Method API",
    "Index Access Method API"
  ]
}
